[Unit]
Description=Restart Stage Kit Pied Button Monitor Service
After=network.target

[Service]
ExecStart=/usr/bin/python3 /opt/StageKitPied/optional/switch_run_script_button.py 19 /opt/StageKitPied/optional/restart_skp.sh /opt/StageKitPied/optional/restart_skp.sh
Restart=always
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
